{
  "name": "pdf-mindmap-generator",
  "version": "1.0.0",
  "description": "Convert PDFs to Mermaid mind maps using AI",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
